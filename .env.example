# Copier en .env (jamais commité) puis remplir.
POSTGRES_USER=airdata
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=airdata
# Clé de signature JWT : 32 caractères minimum. Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=changez-moi-avec-une-cle-longue-et-aleatoire
JWT_MINUTES=60
DEPARTEMENT=75,92,93,94
# Page Airparif scrapée (robots.txt vérifié automatiquement avant chaque collecte)
EPISODES_URL=https://www.airparif.fr/historique-des-episodes-de-pollution
# Lien de téléchargement CSV du jeu « mes idf horaire pm10 » du portail open data Airparif (licence ODbL)
# https://data-airparif-asso.opendata.arcgis.com/datasets/mes-idf-horaire-pm10 -> Télécharger -> CSV -> copier le lien
STATIONS_CSV_URL=
